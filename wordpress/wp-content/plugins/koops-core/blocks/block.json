{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "koops/section",
  "version": "0.8.5",
  "title": "KOOPS sekcija",
  "description": "Esama KOOPS dizaino sistemos sekcija.",
  "category": "koops",
  "icon": "layout",
  "textdomain": "koops",
  "attributes": {
